{
  "name": "expirybox",
  "version": "1.0.1",
  "private": true,
  "description": "ExpiryBox — Personal & Family Vault Expiry Tracker (Offline-First PWA & Unified MERN Stack)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node server/server.js",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=server",
    "android:sync": "npm run build --workspace=client && npm run cap:sync --workspace=client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1"
  },
  "keywords": [
    "pwa",
    "expiry-tracker",
    "family-vault",
    "mern",
    "offline-first"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Aswin",
  "license": "MIT"
}
