# ==============================================================================
# ExpiryBox — Complete Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' (root or server/.env) for local hosting, or paste
# these key-value pairs into your cloud dashboard (Render, Railway, VPS, Docker).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS (REQUIRED)
# ------------------------------------------------------------------------------
# Server Port (Auto-assigned by cloud hosts like Render/Railway, or 5000 locally)
PORT=5000

# Node Environment: 'development' or 'production'
NODE_ENV=production

# JWT Secret for Session Authentication & Token Signing (generate a random string)
JWT_SECRET=super_secret_expirybox_jwt_key_replace_in_production_2026

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/expirybox

# Cloud MongoDB Atlas (Free Tier Cluster):
# Replace <username>, <password>, and cluster domain with your Atlas credentials
MONGO_URI=mongodb+srv://expirybox_admin:YourStrongPassword123@cluster0.abcde.mongodb.net/expirybox?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTOMATED EMAIL REMINDER NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# To receive automated daily deadline reminder emails at 08:00 AM:
# If using Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop
NOTIFICATION_DEFAULT_EMAIL=aswin2690@gmail.com

# ------------------------------------------------------------------------------
# 4. WHATSAPP & SMS WEBHOOK ALERTS (OPTIONAL)
# ------------------------------------------------------------------------------
# Webhook URL to dispatch automated WhatsApp alerts (Twilio / Meta API / Make / Zapier)
WHATSAPP_WEBHOOK_URL=https://api.whatsapp-service.com/webhook/send
DEFAULT_ALERT_PHONE=+919876543210

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT API (OPTIONAL)
# ------------------------------------------------------------------------------
# When running unified hosting on Render, Railway, or VPS, leave this empty
# so the PWA connects to the relative '/api' endpoint on the same host.
# Only set this if your React frontend is hosted on a completely different domain.
# VITE_API_URL=https://your-api-domain.onrender.com/api
