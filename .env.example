# ExpiryBox Environment Configuration
# Copy this file to .env or set these environment variables in your cloud hosting provider (Render, Railway, VPS, Docker, etc.)

# Server Port (assigned automatically by cloud providers or defaults to 5000)
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas free tier cluster)
# Local: mongodb://127.0.0.1:27017/expirybox
# Cloud Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/expirybox?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/expirybox

# JWT Secret for Session Authentication & Token Signing
JWT_SECRET=super_secret_expirybox_jwt_key_replace_in_production_2026

# Node Environment
NODE_ENV=production
